# MLB Probability Board - environment configuration
# Copy this file to .env and fill in your own values, or export these
# directly in your shell. Never commit .env to version control.

# ============================================================
# THE ODDS API (required)
# ============================================================
# Get a key at https://the-odds-api.com (free tier: 500 credits/month).
# Each run of mlb_odds_board.py costs ~3 credits (3 markets x 1 region),
# regardless of how many MLB games are on the slate that day.
ODDS_API_KEY=your-odds-api-key-here

# ============================================================
# OPTIONAL
# ============================================================
# IANA timezone name used to display game start times and the "generated
# at" timestamp. Defaults to UTC if unset.
LOCAL_TIMEZONE=America/New_York
